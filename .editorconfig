# Editor settings shared by Android Studio, VS Code and others. https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
max_line_length = 100

[*.{gradle,kts}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Shell scripts run on Linux (CI) and must keep LF endings.
[{*.sh,gradlew}]
end_of_line = lf

[*.bat]
end_of_line = crlf
